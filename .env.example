# ==============================================================================
# CITAFÁCIL — VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo como .env.local para desarrollo local
# NUNCA compartas claves privadas o de servicio en el frontend o repositorios
# ==============================================================================

# Configuración de Supabase (Requerido para conexión a base de datos y Auth)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key

# Clave de rol de servicio (Únicamente para operaciones administrativas del servidor)
# ADVERTENCIA: NUNCA usar en el frontend ni exponer con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_service_role_key

# URL base de la aplicación (para generar enlaces de confirmación y cancelación)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Proveedor de Notificaciones por Correo (Opcional en MVP, ej. Resend o SMTP)
RESEND_API_KEY=re_ejemplo_api_key_12345
EMAIL_FROM=CitaFácil <notificaciones@citafacil.pe>
